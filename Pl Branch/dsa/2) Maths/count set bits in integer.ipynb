   "source": [
    "###  counts the number of set bits in an integer"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "fc4ac485",
   "metadata": {},
   "outputs": [],
   "source": []
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "08c9bcc6",
   "metadata": {},
   "outputs": [],
   "source": [
    "def count1s(n):\n",
    "    count=0\n",
    "    while(n>0):\n",
    "        if n & 1==1:\n",
    "            count=count+1\n",
    "        n=n>>1\n",
    "    return (count)\n",
    "        "
   ]
  },
