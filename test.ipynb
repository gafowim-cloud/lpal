   "source": [
    "def sl(nums):\n",
    "    \n",
    "    l=sl=-1\n",
    "    for x in nums:\n",
    "        if x > l:\n",
    "            sl=l\n",
    "            l=x\n",
    "        elif x>sl and x<l:\n",
    "            sl=x\n",
    "    return sl"
   ]
